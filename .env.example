# Copy this file to `.env` and fill in values from the Supabase dashboard:
# Project Settings → API → Project URL and anon / publishable key.
#
# Same two names go in Vercel → Project → Settings → Environment Variables
# (Production + Preview). Redeploy after changing them.
#
# VITE_SUPABASE_URL      = address of your Supabase project (public)
# VITE_SUPABASE_ANON_KEY = anon / publishable key (browser-safe; tables are locked)
#
# Never put the service_role / secret key in this frontend app or in Vercel Vite vars.
# The Edge Function `album` uses service_role only on the Supabase server.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
